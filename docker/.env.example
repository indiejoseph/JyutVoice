# Copy to docker/.env and edit. docker compose reads it from the directory of the compose file.

# Required: the bearer key clients send (Authorization: Bearer <key>). Generate one with: openssl rand -hex 32
API_KEY=

# Where the API listens on the host. 127.0.0.1 keeps it local; 0.0.0.0 exposes it (put a TLS proxy in front, and the key above is then all that protects it)
API_BIND_HOST=127.0.0.1
API_PORT=8000

# CPU: threads of the flow decoder and vocoder (set to the CPUs the container may use; 0 = all the host's cores), ONNX threads of the small acoustic model,
# and an optional CPU quota for the container (0 = none)
TORCH_NUM_THREADS=0
ONNX_NUM_THREADS=2
CPUS=0

# Quality / speed: flow decoder steps (the cost is linear in it: 5 took 0.6 of the time of 10; only 10 was scored for quality), pace (the default 1.1 matches the teacher for the English-capable model; 1.0 is 10% faster), characters per synthesis chunk
FLOW_STEPS=10
LENGTH_SCALE=1.1
MAX_CHUNK_CHARS=100

# Loudness: the vocoder's level swings 12 dB with the voice and clips for some, so the speech of each request is levelled to this RMS (dBFS); NORMALIZE_LOUDNESS=false sends the vocoder's own level
NORMALIZE_LOUDNESS=true
OUTPUT_LEVEL_DBFS=-20

# Model files on the host (defaults: ../onnx_models and ../pretrained_models, relative to this directory)
# ONNX_MODELS_DIR=../onnx_models
# PRETRAINED_MODELS_DIR=../pretrained_models

# Browser clients: comma-separated origins (empty = CORS off)
# CORS_ALLOWED_ORIGINS=https://app.example.com
